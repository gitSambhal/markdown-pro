{
  "$schema": "https://raw.githubusercontent.com/neutralinojs/neutralinojs/main/schemas/neutralino.config.schema.json",
  "applicationId": "top.suhail.markdownviewerpro",
  "applicationName": "Markdown Viewer Pro",
  "version": "1.0.0",
  "defaultMode": "window",
  "port": 0,
  "documentRoot": "/dist/",
  "url": "/",
  "applicationIcon": "public/icons/appIcon.png",
  "enableServer": true,
  "enableNativeAPI": true,
  "tokenSecurity": "one-time",
  "logging": {
    "enabled": false,
    "writeToLogFile": false
  },
  "nativeBlockList": [],
  "modes": {
    "window": {
      "title": "Markdown Viewer Pro",
      "width": 1280,
      "height": 840,
      "minWidth": 800,
      "minHeight": 560,
      "center": true,
      "fullScreen": false,
      "alwaysOnTop": false,
      "icon": "/icons/appIcon.png",
      "enableInspector": false,
      "borderless": false,
      "maximize": false,
      "hidden": false,
      "resizable": true,
      "useSavedState": true,
      "exitProcessOnClose": true
    },
    "browser": {
      "tags": [
        "desktop",
        "mobile"
      ]
    }
  },
  "cli": {
    "binaryName": "markdown-viewer-pro",
    "resourcesPath": "/dist/",
    "extensionsPath": "/extensions/",
    "clientLibrary": "/dist/neutralino.js",
    "binaryVersion": "6.9.0",
    "clientVersion": "6.9.0"
  }
}