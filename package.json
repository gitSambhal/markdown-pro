{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist dist_neutralino .tmp binaries storage",
    "lint": "tsc --noEmit",
    "neu": "neu",
    "neu:build": "node scripts/pre-build.cjs && vite build && neu build --release --embed-resources && node scripts/post-build.cjs",
    "neu:run": "vite build && neu run",
    "neu:version": "neu version",
    "neu:update": "neu update",
    "build:native": "node scripts/pre-build.cjs && npm run build && neu build --release --embed-resources && node scripts/post-build.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@neutralinojs/lib": "^6.9.0",
    "@neutralinojs/neu": "^11.7.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/prismjs": "^1.26.6",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "katex": "^0.18.4",
    "lucide-react": "^0.546.0",
    "mermaid": "^11.17.2",
    "motion": "^12.23.24",
    "prismjs": "^1.30.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
